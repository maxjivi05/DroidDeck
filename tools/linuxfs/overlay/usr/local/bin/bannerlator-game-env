#!/usr/bin/python3
import json
import os
import re
import shlex
import sys
from pathlib import Path


def game_id(env):
    prefix = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    if not prefix:
        return None
    value = prefix.rsplit("/", 1)[-1]
    if not re.fullmatch(r"-?[0-9]+", value):
        return None
    number = int(value)
    if not -(2**31) <= number < 2**32 or number == 0:
        return None
    return str(number % 2**32)


def checked(entries, unset):
    for name, value in entries.items():
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            raise ValueError("invalid environment name")
        if value is None and unset:
            continue
        if not isinstance(value, str) or "\0" in value or len(value) > 8192:
            raise ValueError("invalid environment value")
    return entries


def apply_config(env, config, app_id):
    """Built-in defaults fill only what the inherited environment leaves unset; edits always win."""
    if config.get("version") != 1:
        raise ValueError("unsupported environment configuration")
    defaults = checked(dict(config.get("defaults", {})), unset=False)
    entries = dict(config.get("shared", {}))
    entries.update(config.get("games", {}).get(app_id, {}))
    checked(entries, unset=True)
    result = env.copy()
    names = set(defaults) | set(entries)
    for name, value in defaults.items():
        result.setdefault(name, value)
    for name, value in entries.items():
        if value is None:
            result.pop(name, None)
        else:
            result[name] = value
    # Proton writes its log to $HOME unless told otherwise; beside the session's own logs it is
    # collected and shared with them.
    if (result.get("PROTON_LOG", "0") not in ("", "0") and "PROTON_LOG_DIR" not in result and "PROTON_LOG_DIR" not in entries
            and result.get("BL_DEBUG_DIR")):
        result["PROTON_LOG_DIR"] = result["BL_DEBUG_DIR"]
        names.add("PROTON_LOG_DIR")
    return result, sorted(names)


def summary(app_id, env, names):
    values = (f"{name}={shlex.quote(env[name])}" if name in env else f"-{name}" for name in names)
    return f"bannerlator-game-env: app {app_id}: " + " ".join(values)


def main():
    command = sys.argv[1:]
    if not command:
        return 2
    env = os.environ.copy()
    app_id = game_id(env)
    if len(command) > 1 and command[1] == "waitforexitandrun" and app_id:
        path = Path.home() / ".config/droiddeck/game-environment.json"
        try:
            with path.open(encoding="utf-8") as source:
                env, names = apply_config(env, json.load(source), app_id)
            print(summary(app_id, env, names), file=sys.stderr)
        except FileNotFoundError:
            pass
        except (OSError, ValueError, TypeError, AttributeError):
            print("bannerlator-game-env: invalid configuration; using inherited environment", file=sys.stderr)
    os.execvpe(command[0], command, env)


if __name__ == "__main__":
    sys.exit(main())
